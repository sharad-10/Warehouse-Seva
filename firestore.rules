rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function spaceDoc(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId));
    }

    function isSpaceOwner(spaceId) {
      return signedIn() &&
        spaceDoc(spaceId).data.ownerId == request.auth.uid;
    }

    function isSpaceMember(spaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/spaceMembers/$(spaceId + "_" + request.auth.uid));
    }

    function canAccessSpace(spaceId) {
      return isSpaceOwner(spaceId) || isSpaceMember(spaceId);
    }

    function canEditSpace(spaceId) {
      return isSpaceOwner(spaceId) || (
        isSpaceMember(spaceId) &&
        get(/databases/$(database)/documents/spaceMembers/$(spaceId + "_" + request.auth.uid)).data.role == "edit"
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /spaces/{spaceId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isSpaceMember(spaceId)
      );
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /cards/{cardId} {
      allow read: if signedIn() &&
        resource.data.spaceId is string &&
        canAccessSpace(resource.data.spaceId);
      allow create: if signedIn() &&
        request.resource.data.spaceId is string &&
        canEditSpace(request.resource.data.spaceId);
      allow update, delete: if signedIn() &&
        resource.data.spaceId is string &&
        canEditSpace(resource.data.spaceId);
    }

    match /spaceMembers/{memberId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.spaceId is string &&
        isSpaceOwner(request.resource.data.spaceId);
      allow update, delete: if signedIn() &&
        resource.data.spaceId is string &&
        isSpaceOwner(resource.data.spaceId);
    }
  }
}
